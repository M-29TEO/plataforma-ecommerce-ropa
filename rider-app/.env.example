# App del motorizado: se fijan al construir (expo prebuild / gradle). Copiar a .env.local.
# La API detrás de Caddy (fija el tenant por dominio). Desde el emulador de Android, el PC es 10.0.2.2;
# desde un teléfono en la misma Wi-Fi, la IP del PC (p. ej. http://192.168.1.20/api).
EXPO_PUBLIC_API_URL=http://10.0.2.2/api
# Mapa: osm (teselas raster de OpenStreetMap, desarrollo) | pmtiles (archivo de Ecuador servido por Caddy en /tiles)
EXPO_PUBLIC_MAP_TILES=osm
EXPO_PUBLIC_PMTILES_URL=http://10.0.2.2/tiles/ecuador.pmtiles
