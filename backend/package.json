{
  "name": "moda-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend del e-commerce de moda: API, worker y realtime (NestJS, monolito modular)",
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/apps/api/main.js",
    "start:worker": "node dist/apps/worker/main.js",
    "dev:api": "node --env-file-if-exists=.env -r ts-node/register/transpile-only apps/api/main.ts",
    "dev:worker": "node --env-file-if-exists=.env -r ts-node/register/transpile-only apps/worker/main.ts",
    "dev:realtime": "node --env-file-if-exists=.env -r ts-node/register/transpile-only apps/realtime/main.ts",
    "start:realtime": "node dist/apps/realtime/main.js",
    "migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js -m migrations -j js --check-order",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "seed:dev": "node --env-file-if-exists=.env -r ts-node/register/transpile-only scripts/seed-dev.ts",
    "seed:demo": "node --env-file-if-exists=.env -r ts-node/register/transpile-only scripts/seed-demo.ts",
    "token:dev": "node --env-file-if-exists=.env -r ts-node/register/transpile-only scripts/dev-token.ts",
    "sim:rider": "node --env-file-if-exists=.env -r ts-node/register/transpile-only scripts/sim-rider.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "arch:check": "depcruise apps libs scripts test --config .dependency-cruiser.cjs",
    "arch:schemas": "node scripts/ci/check-schemas.mjs",
    "test": "npm run test:unit && npm run test:int",
    "test:unit": "jest -c jest.unit.config.js",
    "test:int": "jest -c jest.int.config.js",
    "sri:sample": "node -r ts-node/register/transpile-only scripts/sri-sample-invoice.ts",
    "sri:cert": "bash scripts/generate-sri-cert.sh",
    "vapid:keys": "node -r ts-node/register/transpile-only scripts/generate-vapid-keys.ts",
    "sec:semgrep": "bash scripts/security/scan.sh semgrep",
    "sec:trivy": "bash scripts/security/scan.sh trivy",
    "sec:scan": "bash scripts/security/scan.sh all",
    "sec:openapi": "node -r ts-node/register/transpile-only scripts/security/openapi.ts security-reports/openapi.json http://localhost:3000",
    "sec:zap": "bash scripts/security/zap.sh"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/platform-socket.io": "11.2.6",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "11.2.6",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "argon2": "^0.44.0",
    "bullmq": "^6.3.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "^4.4.0",
    "handlebars": "^4.7.9",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "libsodium-wrappers": "^0.7.16",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "4.8.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "11.2.6",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "class-validator-jsonschema": "^5.2.0",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "testcontainers": "^12.2.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
