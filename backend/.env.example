# Variables para correr el backend FUERA de Docker (npm run dev:api, migraciones, seed).
# Copia este archivo como backend/.env. Dentro de docker compose se usan las del compose.
DATABASE_URL=postgres://app:cambia_esto@localhost:5432/moda
VALKEY_URL=redis://localhost:6379
JWT_SECRET=cambia_esto_tambien
PORT=3000
# Tiempo de vida de una reserva de stock en segundos (15 min por defecto)
STOCK_RESERVATION_TTL_SECONDS=900
# Carrito de invitado: vida de la cookie httpOnly (días) y atributo Secure (false solo en HTTP local)
GUEST_CART_TTL_DAYS=30
SECURE_COOKIES=false
# Pagos (pasarela simulada). PAYSIM_SECRET debe ser el MISMO que usa el contenedor pasarela-simulada
# (en ./.env de la raíz). PAYSIM_PUBLIC_URL es la página de pago que abre el navegador.
PAYSIM_SECRET=cambia_esto_por_un_secreto_largo
PAYSIM_PUBLIC_URL=http://localhost:8081
PAYMENT_RETURN_URL=http://localhost/checkout/resultado
PAYMENT_ONLINE_TTL_MINUTES=15
# Reversos de reembolsos en la pasarela simulada (servidor a servidor; en Docker, http://pasarela-simulada:3000).
PAYSIM_API_URL=http://localhost:8081
PAYMENT_REFUND_TIMEOUT_MS=10000
# Un reembolso POR ENCIMA de este monto exige dos aprobaciones de personas distintas.
REFUND_DUAL_APPROVAL_ABOVE=100.00
PAYMENT_TRANSFER_TTL_HOURS=12
# Pedidos asistidos del backoffice: minutos para pagar el enlace (tarjeta) que el vendedor envía por
# WhatsApp (15 a 4320; 1440 = 24 h). La transferencia asistida usa el mayor entre esto y PAYMENT_TRANSFER_TTL_HOURS.
ASSISTED_PAYMENT_LINK_TTL_MINUTES=1440
# Comprobantes de transferencia: memory (sin SeaweedFS) o seaweedfs (filer HTTP, puerto 8888)
VOUCHER_STORAGE=memory
SEAWEEDFS_FILER_URL=http://localhost:8888
# Logística. OSRM_URL vacío = sin OSRM: la tarifa del motorizado usa distancia en línea recta.
OSRM_URL=http://localhost:5000
OSRM_TIMEOUT_MS=1500
# Courier simulado (contenedor courier-simulado, puerto 8082). Deben coincidir con ./.env de la raíz.
COURIERSIM_URL=http://localhost:8082
COURIERSIM_API_KEY=cambia_esta_api_key_del_courier
# Timeout por courier al cotizar (después se usa courier_rate_cards) y vigencia de la cotización
COURIER_QUOTE_TIMEOUT_MS=3000
DELIVERY_QUOTE_TTL_MINUTES=15
# Franjas: días que se generan hacia adelante y anticipación mínima (cierre = inicio − esto)
DELIVERY_SLOT_DAYS_AHEAD=7
DELIVERY_SLOT_LEAD_MINUTES=120
# Liquidaciones de motorizados: lunes 03:00 (America/Guayaquil) cierra la semana lunes-domingo anterior
RIDER_SETTLEMENT_CRON=0 3 * * 1
# App del motorizado: despacho automático (segundos para aceptar una oferta y cada cuánto el worker vence
# ofertas y reintenta los envíos sin motorizado) y duración de un turno a demanda.
DISPATCH_OFFER_TTL_SECONDS=45
DISPATCH_SWEEP_EVERY_MS=15000
RIDER_SHIFT_DEFAULT_HOURS=8
# Secreto del código de entrega (OTP de 4 dígitos que ve el cliente). Obligatorio en producción
# (openssl rand -base64 48); en desarrollo, sin él, se deriva de JWT_SECRET.
# DELIVERY_OTP_SECRET=
# Fotos y firmas de las entregas: memory | seaweedfs (por defecto, igual que RETURN_PHOTO_STORAGE)
DELIVERY_PROOF_STORAGE=memory
# Avisos de ofertas al motorizado por ntfy: live | memory (por defecto, igual que NOTIFICATION_TRANSPORT)
# RIDER_OFFER_TRANSPORT=live
# Facturación electrónica SRI. SRI_MODE: simulator (contenedor sri-simulado, puerto 8083) | pruebas | produccion.
SRI_MODE=simulator
SRI_URL=http://localhost:8083
# Certificado autofirmado para la firma XAdES-BES: npm run sri:cert (genera secrets/sri/)
SRI_CERT_PATH=secrets/sri/firma.crt.pem
SRI_KEY_PATH=secrets/sri/firma.key.pem
# Emisor (infoTributaria) y punto de emisión de la tienda en línea (billing.emission_points)
SRI_RUC=1790000000001
SRI_RAZON_SOCIAL=MODA DEMO S.A.
SRI_NOMBRE_COMERCIAL=Moda Demo
SRI_DIR_MATRIZ=Av. Amazonas N34-120 y Av. de la Prensa, Quito
SRI_OBLIGADO_CONTABILIDAD=true
SRI_ESTABLECIMIENTO=001
SRI_PUNTO_EMISION=001
# Máximo de una factura a CONSUMIDOR FINAL (USD). Por encima, el checkout pide cédula/RUC/pasaporte. 0 = sin límite.
SRI_CONSUMIDOR_FINAL_MAX=50.00
# Reintentos con backoff (base × 2^intentos, con tope) y cada cuánto corre el job del worker
SRI_RETRY_BASE_SECONDS=30
SRI_RETRY_MAX_SECONDS=3600
SRI_PROCESS_EVERY_MS=15000
# XML y RIDE: memory (sin SeaweedFS) o seaweedfs (filer HTTP, mismo SEAWEEDFS_FILER_URL)
DOCUMENT_STORAGE=memory
# Email del RIDE + XML al comprador: smtp (Mailpit: bandeja en http://localhost:8025) o memory
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Moda Demo - Facturación <facturacion@moda-demo.test>
# Devoluciones y cambios: plazo desde la entrega, fotos (memory o seaweedfs) y remitente del email con el
# código de la gift card de saldo a favor (usa el mismo MAIL_TRANSPORT / SMTP_URL).
RETURN_WINDOW_DAYS=30
RETURN_PHOTO_STORAGE=memory
AFTERSALES_MAIL_FROM=Moda Demo - Devoluciones <devoluciones@moda-demo.test>
# Carrito abandonado: cada cuánto corre el cron de recordatorios (1 h, 24 h y 72 h sin actividad)
CART_REMINDER_EVERY_MS=300000
# Notificaciones. NOTIFICATION_TRANSPORT: live (Mailpit + Web Push + ntfy) | memory (todo en memoria).
# WhatsApp y SMS son siempre simulados: se registran en el log del worker.
NOTIFICATION_TRANSPORT=live
NOTIFICATIONS_MAIL_FROM=Moda Demo <hola@moda-demo.test>
NOTIFICATIONS_BRAND=Moda Demo
# Base de los enlaces de los mensajes (pedido, seguimiento, carrito)
STOREFRONT_URL=http://localhost
# Web Push: genera las claves con npm run vapid:keys (vacías = Web Push deshabilitado)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@moda-demo.test
# ntfy (bandeja web en http://localhost:8090). El tópico del backoffice debe ser difícil de adivinar.
NTFY_URL=http://localhost:8090
# ntfy tal como lo ve el TELÉFONO del motorizado (GET /rider/me): la IP de tu PC en la Wi-Fi, no localhost.
# Por defecto, NTFY_URL.
# NTFY_PUBLIC_URL=http://192.168.1.50:8090
NTFY_STAFF_TOPIC=moda-demo-backoffice
# NTFY_TOKEN=
# Despachador: cada cuánto envía la cola, intentos y backoff (base × 2^intento, con tope)
NOTIFICATION_DISPATCH_EVERY_MS=5000
NOTIFICATION_MAX_ATTEMPTS=6
NOTIFICATION_RETRY_BASE_SECONDS=30
NOTIFICATION_RETRY_MAX_SECONDS=3600
# CRM. Nominatim propio (docker compose --profile maps); vacío = sin geocodificación (el cliente marca el pin)
NOMINATIM_URL=
NOMINATIM_TIMEOUT_MS=3000
# Puntos por USD de mercadería (IVA incluido, sin envío). Se acreditan al pasar RETURN_WINDOW_DAYS desde la entrega.
LOYALTY_POINTS_PER_USD=1
# Canje por gift card: 100 puntos = 1 USD, mínimo 500 puntos
LOYALTY_REDEEM_POINTS_PER_USD=100
LOYALTY_REDEEM_MIN_POINTS=500
LOYALTY_MATURE_EVERY_MS=3600000
# Wishlist: revisión de precio y stock, baja mínima para avisar (%) y horas entre avisos del mismo producto
WISHLIST_SCAN_EVERY_MS=1800000
WISHLIST_PRICE_DROP_MIN_PERCENT=5
WISHLIST_ALERT_COOLDOWN_HOURS=24
# Referidos: cupón al referente y mínimo del primer pedido del referido
REFERRAL_REWARD=10.00
REFERRAL_MIN_ORDER=30.00
# Fotos de reseñas: seaweedfs | memory (por defecto, igual que RETURN_PHOTO_STORAGE)
REVIEW_PHOTO_STORAGE=memory
# Soporte: horas de SLA por prioridad (horas corridas), cierre automático de resueltos (días) y vigencia del enlace de los emails
SUPPORT_SLA_URGENT_HOURS=4
SUPPORT_SLA_HIGH_HOURS=8
SUPPORT_SLA_NORMAL_HOURS=24
SUPPORT_SLA_LOW_HOURS=72
SUPPORT_AUTO_CLOSE_DAYS=3
SUPPORT_LINK_TTL_DAYS=30
SUPPORT_SWEEP_EVERY_MS=300000
# SUPPORT_LINK_SECRET= (por defecto se deriva de JWT_SECRET)
# Reportes: refresco de las vistas materializadas (15 min), sondeo de exportes, almacenamiento y vigencia de los archivos
REPORTS_REFRESH_EVERY_MS=900000
REPORTS_EXPORT_EVERY_MS=5000
REPORT_EXPORT_STORAGE=seaweedfs
REPORTS_EXPORT_TTL_DAYS=7
REPORTS_EXPORT_MAX_ROWS=20000
# IAM: refresh tokens (cookie httpOnly), 2FA TOTP y versión de las políticas LOPDP.
REFRESH_TOKEN_TTL_DAYS=14
# Path de la cookie refresh_token como la ve el navegador: /v1/auth directo a la API, /api/v1/auth detrás de Caddy.
REFRESH_COOKIE_PATH=/v1/auth
# Con el storefront en desarrollo (proxy de Next en /api, puerto 3100): REFRESH_COOKIE_PATH=/api/v1/auth y
# PAYMENT_RETURN_URL=http://localhost:3100/checkout/resultado
# Clave de 32 bytes (openssl rand -base64 32) para cifrar los secretos TOTP (libsodium). Obligatoria en producción;
# en desarrollo, si falta, se deriva de JWT_SECRET.
# MFA_ENCRYPTION_KEY=
MFA_ISSUER=Moda Demo
POLICY_VERSION=2026-10
# Seguridad (docs/07-seguridad.md). JWT_SECRET: en producción, mínimo 32 caracteres aleatorios (openssl rand -base64 48).
# Campos *_enc (claves de Web Push, tokens de pago): clave de 32 bytes de libsodium (openssl rand -base64 32).
# Obligatoria en producción; en desarrollo, si falta, se deriva de JWT_SECRET. Para rotarla, pasa la vieja a _PREVIOUS.
# DATA_ENCRYPTION_KEY=
# DATA_ENCRYPTION_KEY_PREVIOUS=
# CORS: orígenes permitidos separados por coma (sin comodines). Vacío = solo mismo origen (storefront detrás de Caddy).
CORS_ORIGINS=http://localhost:3000
# Proxies de confianza para X-Forwarded-For (req.ip real): Caddy en la red de Docker.
TRUST_PROXY=loopback, linklocal, uniquelocal
HTTP_BODY_LIMIT=100kb
# Rate limiting: valkey (contadores compartidos entre réplicas) | memory. RATE_LIMIT_ENABLED=false solo para pruebas de carga.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=valkey
# Hosts aceptados como endpoint de Web Push (anti SSRF). "*.dominio" = subdominios.
WEBPUSH_ALLOWED_HOSTS=fcm.googleapis.com,*.push.services.mozilla.com,web.push.apple.com,*.push.apple.com,*.notify.windows.com
# Observabilidad: trazas, métricas y logs por OTLP/HTTP hacia grafana/otel-lgtm (docker compose --profile obs up lgtm).
# Sin OTEL_EXPORTER_OTLP_ENDPOINT (o con OTEL_SDK_DISABLED=true) no se exporta nada.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_METRIC_EXPORT_INTERVAL=15000
# OTEL_TRACES_SAMPLER=parentbased_traceidratio   OTEL_TRACES_SAMPLER_ARG=0.2   (por defecto se traza todo)
# Logs: json (una línea JSON por evento, con request_id y trace_id) | pretty (el de Nest, en colores). Nivel mínimo:
# verbose, debug, log, warn, error o fatal.
LOG_FORMAT=json
LOG_LEVEL=log
# Tiempo real (apps/realtime, npm run dev:realtime): Socket.IO en este puerto, ruta /ws/socket.io (Caddy: /ws/*).
REALTIME_PORT=3002
# valkey | memory (solo tests)
REALTIME_TRANSPORT=valkey
# Catálogo público: base de las fotos de producto con clave relativa (el storefront sirve /media/demo).
CATALOG_MEDIA_BASE_URL=/media
