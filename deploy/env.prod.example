# .env de PRODUCCIÓN: cp deploy/env.prod.example .env  (en /opt/moda-prod del servidor; NUNCA al repo).
# Además de esto, las variables de la aplicación de .env.example (raíz del repo) con valores reales.
# Secretos: openssl rand -base64 48 (o 32 donde lo pide). Ver docs/08-despliegue.md.

# ---------- Compose: qué archivos y perfiles componen el entorno ----------
COMPOSE_PROJECT_NAME=moda-prod
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:deploy/compose.server.yml:deploy/compose.prod.yml:deploy/compose.offsite.yml
COMPOSE_PROFILES=front,backoffice,sims,obs

# ---------- Imágenes (las publica .woodpecker/images.yml) ----------
REGISTRY=git.miuniversidad.edu.ec
IMAGE_OWNER=moda
# En prod solo tags de git (lo reescribe .woodpecker/deploy-prod.yml en cada despliegue).
TAG=v1.0.0

# ---------- Dominios (TLS automático en el servicio edge) ----------
SITE_ADDRESS=tienda.miuniversidad.edu.ec
PUBLIC_URL=https://tienda.miuniversidad.edu.ec
STOREFRONT_PUBLIC_URL=https://tienda.miuniversidad.edu.ec
PAYSIM_ADDRESS=pagos.tienda.miuniversidad.edu.ec
NTFY_ADDRESS=ntfy.tienda.miuniversidad.edu.ec
ACME_EMAIL=ti@miuniversidad.edu.ec

# ---------- Correo real (SMTP de la institución) ----------
SMTP_URL=smtp://usuario:clave@smtp.miuniversidad.edu.ec:587

# ---------- Backups (pgBackRest) ----------
BACKUP_HOUR=2
BACKUP_FULL_DOW=7
PG_MEMORY_LIMIT=2g
# repo2: copia cifrada fuera del servidor, en el S3 del host de backups (deploy/compose.offsite.yml,
# infra/backup-host). Mismas credenciales que el .env de ese host.
BACKUP_S3_ENDPOINT=backups.miuniversidad.edu.ec
BACKUP_S3_PORT=443
BACKUP_S3_BUCKET=moda-backups
BACKUP_S3_KEY=cambia_esto_openssl_rand_hex_20
BACKUP_S3_KEY_SECRET=cambia_esto_openssl_rand_hex_20
# Solo con certificado propio (sin Let's Encrypt): su CA en deploy/secrets/s3/ca.crt
# BACKUP_S3_CA_FILE=/etc/pgbackrest/s3/ca.crt
BACKUP_CIPHER_PASS=cambia_esto_por_openssl_rand_base64_48
BACKUP_REPO2_RETENTION_FULL=8

# ---------- Aplicación (mismas claves que .env.example; aquí solo las obligatorias en producción) ----------
PG_PASSWORD=cambia_esto
JWT_SECRET=cambia_esto_por_openssl_rand_base64_48
MFA_ENCRYPTION_KEY=cambia_esto_por_openssl_rand_base64_32
DATA_ENCRYPTION_KEY=cambia_esto_por_openssl_rand_base64_32
DELIVERY_OTP_SECRET=cambia_esto_por_openssl_rand_base64_48
PAYSIM_SECRET=cambia_esto_por_un_secreto_largo
COURIERSIM_SECRET=cambia_esto_por_otro_secreto_largo
COURIERSIM_API_KEY=cambia_esta_api_key_del_courier
STORE_TENANT_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NTFY_STAFF_TOPIC=cambia-este-topico-dificil-de-adivinar
NTFY_OPS_TOPIC=cambia-este-otro-topico
GRAFANA_ADMIN_PASSWORD=cambia_esto
KUMA_ADMIN_USER=admin
KUMA_ADMIN_PASSWORD=cambia_esto
