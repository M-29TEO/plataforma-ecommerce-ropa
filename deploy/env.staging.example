# .env de STAGING: cp deploy/env.staging.example .env  (en /opt/moda-staging del servidor; NUNCA al repo).
# Mismas claves que prod, con secretos PROPIOS (nunca los de prod) y sin copia fuera del servidor.

# ---------- Compose ----------
COMPOSE_PROJECT_NAME=moda-staging
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:deploy/compose.server.yml:deploy/compose.staging.yml
COMPOSE_PROFILES=front,backoffice,sims,obs

# ---------- Imágenes: la última de main (lo reescribe .woodpecker/deploy-staging.yml con el sha) ----------
REGISTRY=git.miuniversidad.edu.ec
IMAGE_OWNER=moda
TAG=main

# ---------- Dominios ----------
SITE_ADDRESS=staging.tienda.miuniversidad.edu.ec
PUBLIC_URL=https://staging.tienda.miuniversidad.edu.ec
STOREFRONT_PUBLIC_URL=https://staging.tienda.miuniversidad.edu.ec
PAYSIM_ADDRESS=pagos.staging.tienda.miuniversidad.edu.ec
NTFY_ADDRESS=ntfy.staging.tienda.miuniversidad.edu.ec
ACME_EMAIL=ti@miuniversidad.edu.ec
# Si comparte host con prod: otros puertos y un proxy delante, o mejor, otro host.
# EDGE_HTTP_PORT=8080
# EDGE_HTTPS_PORT=8443

# ---------- Backups: solo repo1 (volumen local) ----------
BACKUP_HOUR=3
PG_MEMORY_LIMIT=1g

# ---------- Aplicación ----------
PG_PASSWORD=cambia_esto
JWT_SECRET=cambia_esto_por_openssl_rand_base64_48
MFA_ENCRYPTION_KEY=cambia_esto_por_openssl_rand_base64_32
DATA_ENCRYPTION_KEY=cambia_esto_por_openssl_rand_base64_32
DELIVERY_OTP_SECRET=cambia_esto_por_openssl_rand_base64_48
PAYSIM_SECRET=cambia_esto_por_un_secreto_largo
COURIERSIM_SECRET=cambia_esto_por_otro_secreto_largo
COURIERSIM_API_KEY=cambia_esta_api_key_del_courier
STORE_TENANT_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NTFY_STAFF_TOPIC=cambia-este-topico-staging
NTFY_OPS_TOPIC=cambia-este-otro-topico-staging
GRAFANA_ADMIN_PASSWORD=cambia_esto
KUMA_ADMIN_USER=admin
KUMA_ADMIN_PASSWORD=cambia_esto
