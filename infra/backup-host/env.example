# .env del host de backups (cp env.example .env). Las credenciales S3 son las mismas que BACKUP_S3_KEY y
# BACKUP_S3_KEY_SECRET del .env de prod (deploy/env.prod.example). Genera ambas con openssl rand -hex 20.
BACKUP_S3_DOMAIN=backups.miuniversidad.edu.ec
BACKUP_S3_KEY=
BACKUP_S3_KEY_SECRET=
ACME_EMAIL=ti@miuniversidad.edu.ec
