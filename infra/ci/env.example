# .env de la forja + CI (cp env.example .env). Ver docs/08-despliegue.md, 8.3.
# Nombre o IP con que el navegador Y los contenedores llegan a este host (en Docker Desktop basta
# host.docker.internal; en un servidor Linux, su IP o dominio en la red).
FORGE_HOST=host.docker.internal
# openssl rand -hex 32
WOODPECKER_AGENT_SECRET=
# Tras crear la app OAuth2 en Forgejo (redirect: http://<FORGE_HOST>:8000/authorize):
WOODPECKER_FORGEJO_CLIENT=
WOODPECKER_FORGEJO_SECRET=
# Usuario(s) de Forgejo administradores de Woodpecker, separados por coma.
WOODPECKER_ADMIN=
# Cerrar el registro de Forgejo una vez creadas las cuentas del equipo.
FORGEJO_DISABLE_REGISTRATION=false
