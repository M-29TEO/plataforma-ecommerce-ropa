      "title": "Eventos de dominio por minuto",
      "description": "Lo que el relay del outbox publica. Las series FALLÓ son consumidores que lanzan error (se reintentan).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (event_type) (rate(outbox_events_published_total[$__rate_interval])) * 60",
          "legendFormat": "{{event_type}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (event_type) (rate(outbox_events_failed_total[$__rate_interval])) * 60",
          "legendFormat": "FALLÓ {{event_type}}",
