    {
      "type": "logs",
      "title": "Logs de error (api y worker)",
      "description": "Click en una línea → trace_id → la traza en Tempo. Filtrar por request_id: {service_name=~\"moda-.*\"} | request_id=\"<X-Request-Id>\"",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service_name=~\"moda-api|moda-worker\"} | detected_level=~\"error|fatal\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
