# Copia este archivo como .env y cambia los valores. NUNCA subas .env al repositorio.
PG_PASSWORD=cambia_esto
PAYSIM_SECRET=cambia_esto_por_un_secreto_largo
# Solo si la API corre fuera de Docker y la pasarela simulada dentro:
# PAYSIM_WEBHOOK_URL=http://host.docker.internal:3000/v1/webhooks/payments/simulator
# Pedidos asistidos (backoffice): minutos para pagar el enlace que envía el vendedor (15 a 4320; por defecto 1440 = 24 h)
# ASSISTED_PAYMENT_LINK_TTL_MINUTES=1440
COURIERSIM_SECRET=cambia_esto_por_otro_secreto_largo
COURIERSIM_API_KEY=cambia_esta_api_key_del_courier
# Solo si la API corre fuera de Docker y el courier simulado dentro:
# COURIERSIM_WEBHOOK_URL=http://host.docker.internal:3000/v1/webhooks/couriers/simulator
JWT_SECRET=cambia_esto_tambien
# SRI simulado: segundos que "procesa" antes de autorizar y máximo a consumidor final (igual que el backend)
# SRISIM_AUTH_DELAY_MS=3000
# SRI_CONSUMIDOR_FINAL_MAX=50
# Web Push (VAPID): genera con  cd backend && npm run vapid:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Tópico ntfy de alertas del backoffice (facturas rechazadas por el SRI). Que sea difícil de adivinar.
NTFY_STAFF_TOPIC=moda-demo-backoffice
# App del motorizado: ntfy como lo ve el teléfono (IP de tu PC en la Wi-Fi; dentro de Docker la API usa http://ntfy:80)
# NTFY_PUBLIC_URL=http://192.168.1.50:8090
# Secreto del código de entrega (OTP) de los envíos con motorizado. Obligatorio en producción (openssl rand -base64 48).
# DELIVERY_OTP_SECRET=
# IAM: clave de 32 bytes para cifrar los secretos TOTP del 2FA (openssl rand -base64 32). Obligatoria en producción.
# MFA_ENCRYPTION_KEY=   (sin ella, fuera de NODE_ENV=production se deriva de JWT_SECRET)
# Seguridad: clave libsodium de los campos *_enc (openssl rand -base64 32). Obligatoria en producción.
# DATA_ENCRYPTION_KEY=
# Tenant de la tienda (uuid de iam.tenants, lo imprime npm run seed:dev): Caddy lo fija en X-Tenant-Id.
STORE_TENANT_ID=
# Storefront (perfil front): URL pública (canónicas, sitemap) y mapa base: osm (desarrollo) o pmtiles.
# STOREFRONT_PUBLIC_URL=http://localhost
# MAP_TILES=osm
# Observabilidad (perfil obs): Grafana en http://localhost:3001, Uptime Kuma en http://localhost:3002.
# Tópico ntfy de las alertas de operación (Grafana y Uptime Kuma). Que sea difícil de adivinar.
NTFY_OPS_TOPIC=moda-demo-operacion
GRAFANA_ADMIN_PASSWORD=cambia_esto
# Admin de Uptime Kuma: lo crea  docker compose --profile obs run --rm kuma-setup  (junto con los monitores).
KUMA_ADMIN_USER=admin
KUMA_ADMIN_PASSWORD=cambia_esto_tambien
