# Entorno de la DEMO (docs/DEMO.md). Cópialo como .env y levanta todo con un solo comando:
#
#   cp .env.demo.example .env
#   docker compose up -d --build
#
# Los secretos de abajo son PÚBLICOS (están en el repositorio): sirven solo para la demo en un PC.
# Para staging o producción usa deploy/env.*.example y genera secretos nuevos (openssl rand -base64 48).

# Tienda + backoffice + simuladores + migraciones y seed de demo (perfil seed: 3 meses de pedidos).
COMPOSE_PROFILES=front,backoffice,sims,seed

# Tenant de la tienda con id fijo: el seed lo crea con este id y Caddy lo fija en X-Tenant-Id.
STORE_TENANT_ID=c9d1e23e-e0e5-4740-9c6b-5acfa4e64b3a

PG_PASSWORD=demo-postgres-2026
JWT_SECRET=unmQe14ukRNiMXna6tj+zz71EptWpFT8PCX3xxJ4M+WvC8i6
DELIVERY_OTP_SECRET=0lqBHaZi/p5+R8bpaNUwXc2ukB9iKS+t99wIbRxizGw4N+Rt
MFA_ENCRYPTION_KEY=p1kQKe4tk0yXLIN+29wlUh9ppAwkZM/4S4vVnS8nKDY=
DATA_ENCRYPTION_KEY=c2HPipn+ZmAr0AMDQ2ujl8hfiabYv8PPdF1zonlYvTI=
PAYSIM_SECRET=demo-pasarela-secreto-compartido-2026
COURIERSIM_SECRET=demo-courier-secreto-compartido-2026
COURIERSIM_API_KEY=demo-courier-api-key

# Puertos de los simuladores en el PC. Si alguno está ocupado (docker compose avisa "port is already
# allocated"), cámbialo aquí: la página de pago usa PAYSIM_PORT automáticamente.
PAYSIM_PORT=8081
COURIERSIM_PORT=8082
SRISIM_PORT=8083

# SRI simulado: segundos que "procesa" antes de autorizar (la factura llega autorizada a Mailpit).
SRISIM_AUTH_DELAY_MS=3000

# Courier simulado: cada cuánto avanza un envío de estado.
COURIERSIM_STEP_MS=20000

# Límite de intentos de login (5/min y 20/h por IP): en una demo en un solo PC todos los roles salen de
# la misma IP y se agota al cambiar de usuario. Apagado SOLO aquí; si publicas la demo con frp
# (deploy/compose.demo.yml), ponlo en true.
RATE_LIMIT_ENABLED=false

# Reportes: la demo refresca las vistas del dashboard cada minuto (por defecto, cada 15).
REPORTS_REFRESH_EVERY_MS=60000

# Avisos al personal (backoffice) y de operación por ntfy (http://localhost:8090).
NTFY_STAFF_TOPIC=moda-demo-backoffice
NTFY_OPS_TOPIC=moda-demo-operacion

# App del motorizado en un teléfono de la misma Wi-Fi: ntfy como lo ve el teléfono (IP de este PC).
# NTFY_PUBLIC_URL=http://192.168.1.50:8090

# Web Push (opcional): cd backend && npm run vapid:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Sin los perfiles maps (Nominatim, OSRM) ni obs (Grafana): vacías, así la API no busca esos servicios.
# La cotización usa distancia en línea recta y el cliente marca su dirección en el mapa. Para usarlos,
# borra estas líneas y agrega maps/obs a COMPOSE_PROFILES (ver docker-compose.yml).
NOMINATIM_URL=
OSRM_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Mapa base del storefront y del backoffice: osm (teselas de OpenStreetMap) o pmtiles (infra/tiles).
MAP_TILES=osm
